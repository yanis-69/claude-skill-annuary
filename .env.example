# Copier ce fichier en .env puis renseigner les valeurs.

# Jeton GitHub (fine-grained, lecture des dépôts publics suffit).
# Obligatoire pour la recherche de code et pour passer à 5000 requêtes/heure.
GITHUB_TOKEN=

# Backend d'enrichissement : auto | claude | codex | heuristic
# auto = claude si le CLI est présent, sinon codex, sinon heuristic.
ENRICH_BACKEND=auto

# Chemin de la base SQLite (relatif à la racine du projet ou absolu).
DB_PATH=data/skills.db

# Optionnel
# ENRICH_CONCURRENCY=3
# ENRICH_TIMEOUT=120
# CLAUDE_MODEL=haiku
# MAX_SKILLS_PER_REPO=1000
